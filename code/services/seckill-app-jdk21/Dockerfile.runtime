# Offline runtime image for the JDK 21 app tier.
#
# The shipped Dockerfile builds the jar inside a maven image. On hosts where the
# container cannot reach Maven Central (TLS handshake fails in this lab), build
# the jar on the host and use this file instead:
#
#   cd code && mvn -pl services/seckill-app-jdk21 -am -DskipTests package
#   docker build -f code/services/seckill-app-jdk21/Dockerfile.runtime \
#     -t java-learn-lab/seckill-app:jdk21 code/services/seckill-app-jdk21
#
# The OTel agent is copied from an image that already carries it (the previous
# app image), so the agent version does not drift between rebuilds and no
# Maven Central access is needed at image-build time.
ARG OTEL_SOURCE_IMAGE=java-learn-lab/seckill-app:otel-src
ARG OTEL_SOURCE_AGENT=/app/otel/opentelemetry-javaagent.jar

FROM ${OTEL_SOURCE_IMAGE} AS otel

# JDK (not JRE): the thread-lab snapshot bundle runs jcmd Thread.print -l,
# GC.heap_info and GC.class_histogram inside the container.
FROM eclipse-temurin:21-jdk-alpine

ARG OTEL_SOURCE_AGENT=/app/otel/opentelemetry-javaagent.jar

LABEL org.opencontainers.image.title="java-learn-lab seckill-app (JDK 21)"
LABEL org.opencontainers.image.version="0.1.0-SNAPSHOT"

RUN addgroup -S app && adduser -S -G app app

WORKDIR /app
COPY --from=otel ${OTEL_SOURCE_AGENT} /app/otel/opentelemetry-javaagent.jar
COPY target/seckill-app-jdk21-*.jar /app/app.jar
RUN chown -R app:app /app

USER app
EXPOSE 8080

ENTRYPOINT ["java", \
  "-javaagent:/app/otel/opentelemetry-javaagent.jar", \
  "-XX:MaxRAMPercentage=70", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-jar", "/app/app.jar"]
