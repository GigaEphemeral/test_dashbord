<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.javalearn.lab</groupId>
    <artifactId>java-learn-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>seckill-app-jdk21</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Spring MVC needs parameter names for binding; carried forward from Task 7. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <start-class>com.javalearn.lab.seckill.SeckillApplication</start-class>
    <!-- Pinned from Maven Central (Task 16). The seckill admission path uses
         Redisson only for its per-product distributed lock; Spring Data Redis
         keeps serving the cache and the atomic Lua stock store. -->
    <redisson.version>3.52.0</redisson.version>
    <!-- Spring Boot 3.5.16 manages Spring AMQP 3.2.12; pinned explicitly so the
         broker protocol/client version is visible and stable in this POM. -->
    <spring-amqp.version>3.2.12</spring-amqp.version>
    <!-- Testcontainers 1.21.4 (the Boot-managed line), pinned for the RabbitMQ
         module used by every full-context test. -->
    <rabbitmq-testcontainers.version>1.21.4</rabbitmq-testcontainers.version>
    <!-- Resilience4j 2.4.0 (Maven Central, 2026-03-14) is the 2.x line built
         for Spring 6 / Boot 3 and Java 17+; the registries are used
         programmatically so the runtime lab toggles can skip protection. -->
    <resilience4j.version>2.4.0</resilience4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot-jdk21.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Explicit Spring AMQP pin (Task 16). The Boot BOM already selects
           3.2.12; keeping it visible here makes the broker client version an
           intentional, reviewable decision. -->
      <dependency>
        <groupId>org.springframework.amqp</groupId>
        <artifactId>spring-rabbit</artifactId>
        <version>${spring-amqp.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.javalearn.lab</groupId>
      <artifactId>platform-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.javalearn.lab</groupId>
      <artifactId>platform-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.javalearn.lab</groupId>
      <artifactId>seckill-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- platform-observability already brings Actuator + Prometheus; keep both
         explicit so the app shell's scrape contract is visible in its own POM. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Catalog persistence: JPA, MySQL and Flyway live only in this JDK 21 shell. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- Two-level product cache (Task 14): Spring Cache abstraction, Redis L2
         and Caffeine L1 live only in this JDK 21 shell. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- Async seckill admission (Task 16): Redisson per-product lock and
         Spring AMQP producer/consumer live only in this JDK 21 shell. -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
      <version>${redisson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>

    <!-- Rate limiting and circuit breaking (Task 17). The Boot 3 starter binds
         resilience4j.ratelimiter/circuitbreaker instances from application.yml;
         the app resolves the registries and executes them manually (annotations
         cannot be skipped by the runtime lab toggles). resilience4j-micrometer
         exports resilience4j_ratelimiter_* and resilience4j_circuitbreaker_*. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Repository integration tests run against the same MySQL major version
         as the lab stack (mysql:8.4.4 is already cached locally). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Generic container for the Redis 7.4.2 L2 integration tests. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- RabbitMQ 4.1 broker for the full-context tests: the async seckill
         listener starts with the application context. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <version>${rabbitmq-testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Two in-memory H2 databases prove the write/read routing without MySQL
         (ReadWriteRoutingTest). Test scope only. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot-jdk21.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Surefire's defaults do not pick up *IT classes; run the Testcontainers
           repository test as part of the normal `mvn test` cycle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
