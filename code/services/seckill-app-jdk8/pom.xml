<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.javalearn.lab</groupId>
    <artifactId>java-learn-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>seckill-app-jdk8</artifactId>
  <packaging>jar</packaging>

  <!-- EOL teaching shell (design section 10): Spring Boot 2.7.18 on Java 8, the
       JDK 8 half of the D7 dual-runtime comparison. The version property is the
       reactor root's spring-boot-jdk8.version (2.7.18) so both shells keep one
       source of truth; this module overrides the root's release 21 back to 8. -->
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <!-- Spring MVC needs parameter names for @PathVariable/@RequestParam binding. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <spring-boot.version>${spring-boot-jdk8.version}</spring-boot.version>
    <start-class>com.javalearn.lab.seckill.jdk8.SeckillJdk8Application</start-class>
    <!-- Pin: Boot 2.7.18's BOM only manages the NEW com.mysql:mysql-connector-j
         coordinates, not the legacy mysql:mysql-connector-java this shell uses.
         Same driver version the BOM selects (8.0.33, still Java 8 compatible). -->
    <mysql-connector-java.version>8.0.33</mysql-connector-java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Shared Java 8 bytecode (maven.compiler.release 8 in both modules), so the
         EOL runtime can load them. platform-observability is Spring Boot 3/jakarta
         and is deliberately NOT a dependency. -->
    <dependency>
      <groupId>com.javalearn.lab</groupId>
      <artifactId>platform-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.javalearn.lab</groupId>
      <artifactId>seckill-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 1.9.17 (Boot 2.7.18 BOM) exports the same metric names the D7 panel reads. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Business parity with the JDK 21 peers: the catalog read path (including
         the two-level cache and the /lab/cache contract), the durable order path
         and the async seckill admission path. Redis is the stock/idempotency
         store and the product-cache L2, RabbitMQ the admission queue and
         Redisson the per-product lock/bloom filter. Flyway stays in the JDK 21
         shell (later steps own the schema); this shell reuses the Flyway-owned
         tables. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Two-level product cache, the same stack the JDK 21 peers run: Spring's
         cache abstraction + Caffeine L1 + the Redis starter above as L2. The
         Boot 2.7.18 BOM manages Caffeine 2.9.3, which is also the last
         Java 8-compatible line (3.x requires Java 11); the API used here
         (newBuilder/recordStats/expireAfterWrite/refreshAfterWrite/policy) is
         identical, so the cache semantics match the JDK 21 shell. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- 3.52.0 is the verified Java 8 bytecode line of the Redisson client
         (the Boot 2.7 BOM would otherwise pick an older release). -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
      <version>3.52.0</version>
    </dependency>
    <!-- 1.7.1 is the Java 8 / Boot 2 line; 2.x requires Boot 3. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot2</artifactId>
      <version>1.7.1</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <version>1.7.1</version>
    </dependency>
    <!-- Boot 2.7 artifact id (mysql-connector-j is the Boot 3 line); version pinned
         above because the 2.7.18 BOM only manages the new coordinates. -->
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <version>${mysql-connector-java.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- demo profile: boot with no external services so startup time is comparable. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The ported cache-lab unit tests mock the final strategy/guard classes
         exactly as the JDK 21 peers do (Mockito 5 enables the inline mock maker
         by default). Boot 2.7.18's Mockito 4.5.1 needs the explicit inline
         artifact for final classes; test scope only, no runtime impact. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The module targets Java 8 but the lab's Maven runs on a newer JDK.
           Mockito 4.5.1's bundled Byte Buddy predates that JDK's class-file
           version; the experimental switch lets the inline mock maker read it.
           It changes nothing when the tests run on the Java 8 runtime. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <net.bytebuddy.experimental>true</net.bytebuddy.experimental>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- repackage so the EOL JRE can run `java -jar target/seckill-app-jdk8-....jar`. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>${start-class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
