# Copy to .env (up.sh does this automatically if .env is missing).
# Lab-only defaults. Never use these credentials outside the local demo.

COMPOSE_PROJECT_NAME=java-learn-lab
TZ=UTC

NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.4
REDIS_IMAGE=redis:7.4.2-alpine
RABBITMQ_IMAGE=rabbitmq:4.1.0-management
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.16.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.0

MYSQL_ROOT_PASSWORD=labroot
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=seckill

# Lab-only account for jl-mysqld-exporter. The database-side password is fixed in
# mysql/init/00-exporter.sql: changing this value requires updating that SQL file too.
MYSQLD_EXPORTER_PASSWORD=exporter

RABBITMQ_DEFAULT_USER=lab
RABBITMQ_DEFAULT_PASS=lab
