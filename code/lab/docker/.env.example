# Copy to .env (up.sh does this automatically if .env is missing).
# Lab-only defaults. Never use these credentials outside the local demo.

COMPOSE_PROJECT_NAME=java-learn-lab
TZ=UTC

NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.4
REDIS_IMAGE=redis:7.4.2-alpine
RABBITMQ_IMAGE=rabbitmq:4.1.0-management
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.16.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.0
PROMETHEUS_IMAGE=prom/prometheus:v3.0.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
TEMPO_IMAGE=grafana/tempo:2.6.0
# Candidate tag 0.115.0 could not be pulled through the local registry mirror;
# 0.116.1 is the nearest tag that pulls and runs with the same config schema.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.116.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# OTel Java agent baked into java-learn-lab/seckill-app:jdk21 from Maven Central.
OTEL_AGENT_VERSION=2.10.0

MYSQL_ROOT_PASSWORD=labroot
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=seckill

# Lab-only account for jl-mysqld-exporter. The database-side password is fixed in
# mysql/init/00-exporter.sql: changing this value requires updating that SQL file too.
MYSQLD_EXPORTER_PASSWORD=exporter

RABBITMQ_DEFAULT_USER=lab
RABBITMQ_DEFAULT_PASS=lab

# Lab-only Grafana admin. Also used by verify.sh for the Grafana APIs.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=labadmin

# Shared secret for the lab console API (sent as X-Lab-Token). Local demo only;
# changing it requires restarting chaos-controller and updating the console token.
LAB_TOKEN=lab-token

# Chaos-controller target policy (Task 22b / M3-1c). The compose defaults are
# already demo-ready; set these only to narrow/widen them for a specific run.
# CHAOS_GUIDE_TARGET_PATTERN is a whole-name match for scenario targets: apps
# plus the HA Redis data nodes, never the Sentinel containers.
CHAOS_GUIDE_TARGET_PATTERN='^jl-(app|redis)-[0-9]$'
# Datastore allow-list: closed by default in the code (empty = every
# mysql/redis/rabbit/mongo/postgres target is refused). The lab ships exactly
# the three HA Sentinel data nodes plus the three HA MySQL nodes (the step-31
# Router/failover drill needs to kill jl-mysql-1); whole-name matching keeps
# the dev single nodes `jl-redis` and `jl-mysql`, the exporters, jl-redis-10
# and jl-mysql-10 out. Do NOT widen this to `jl-redis`, `jl-mysql`, a bare
# `.*` or a loose substring in a delivered config.
CHAOS_DATASTORE_ALLOWED_TARGET_PATTERN='^jl-(redis|mysql)-[1-3]$'

# Runtime experiment toggles (Task 17). These seed each app instance; a runtime
# POST /lab/toggles changes only the instance that received it until the
# chaos-controller broadcast lands. Local demo only.
LAB_TOGGLE_LOCK=true
LAB_TOGGLE_IDEMPOTENCY=true
LAB_TOGGLE_MQ=true
LAB_TOGGLE_RATELIMIT=true
LAB_TOGGLE_CIRCUITBREAKER=true
LAB_TOGGLE_CACHE=true

# Order-accept SLO buckets (Task 18). Comma-separated Micrometer durations used
# by management.metrics.distribution for order_accept_seconds; D4 reads the
# exported histogram buckets. Change here to widen/narrow the SLO set.
ORDER_ACCEPT_SLO=50ms,100ms,300ms,500ms,1s,2s

# Full-stack smoke (code/lab/scripts/smoke.sh). Process environment overrides
# these values; an explicit SMOKE_LAB_TOKEN falls back to LAB_TOKEN. Product 20
# is reserved for the async seckill path, product 1 for synchronous orders.
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_PRODUCT_ID=1
SMOKE_SECKILL_PRODUCT_ID=20
SMOKE_USER=smoke-user
SMOKE_TIMEOUT_SECONDS=10
SMOKE_POLL_RETRIES=30
SMOKE_POLL_INTERVAL_SECONDS=1

# --- Redis Sentinel topology (compose profile "ha", Task M3-1a) -----------------
# Only used by `up.sh --profile ha` / compose.ha.yml. The dev profile keeps the
# single-node jl-redis untouched, so nothing here affects the default stack.
# Budget check (design doc §3.1, ~800MB for 1 master + 2 replicas + 3 Sentinels
# plus one exporter per data node): 3x128m + 3x64m + 3x48m = 720m.

# Kept identical to REDIS_IMAGE so the ha profile pulls nothing new; if you bump
# REDIS_IMAGE, bump this one too (or point it at a tag already present locally).
REDIS_HA_IMAGE=redis:7.4.2-alpine

# Master name the Sentinels monitor and the app asks for (design §8.2: mymaster).
REDIS_HA_MASTER_NAME=mymaster

# Container-internal ports. Host ports are NOT published by default: the topology
# is jl-net-only (see the commented ports: block in compose.ha.yml for the demo
# override, which defaults to 6380-6382 / 26380-26382 so it cannot collide with
# dev's 127.0.0.1:6379).
REDIS_HA_NODE_PORT=6379
REDIS_HA_SENTINEL_PORT=26379

# Single lab password for the whole HA group: applied as requirepass + masterauth on
# every data node and as `sentinel auth-pass` on every Sentinel. masterauth is what
# lets a demoted old master rejoin as a replica after a failover. Lab-only value.
REDIS_HA_REQUIRE_AUTH=true
REDIS_HA_PASSWORD=labredis

# Sentinel election knobs. quorum 2 of 3 Sentinels; down-after 5s and a 15s failover
# budget keep the drill watchable (~5-20s from `docker stop` to the new master).
REDIS_HA_QUORUM=2
REDIS_HA_DOWN_AFTER_MS=5000
REDIS_HA_PARALLEL_SYNC=1
REDIS_HA_FAILOVER_TIMEOUT_MS=15000

# Pinned addresses on the Sentinel-only network (compose.ha.yml -> jl-sentinel-net).
# Sentinel monitors and replicates by IP on purpose: the moment a container stops,
# its compose DNS name disappears from Docker's embedded DNS, and a Sentinel that was
# configured with that name logs "Failed to resolve hostname", enters #tilt mode and
# refuses to promote anybody (measured in the M3-1a drill). A pinned IP is stable
# across `docker stop`/`docker start`/recreate, so the failover and the old master
# rejoining as a replica both work. Keep the /24 hosts inside REDIS_HA_SUBNET and
# change the subnet (not just the hosts) if it collides on your machine.
REDIS_HA_SUBNET=172.28.190.0/24
REDIS_HA_REDIS_1_IP=172.28.190.11
REDIS_HA_REDIS_2_IP=172.28.190.12
REDIS_HA_REDIS_3_IP=172.28.190.13
REDIS_HA_SENTINEL_1_IP=172.28.190.21
REDIS_HA_SENTINEL_2_IP=172.28.190.22
REDIS_HA_SENTINEL_3_IP=172.28.190.23

# Address written into `sentinel monitor` and into the replicas' --replicaof: compose
# wires both from REDIS_HA_REDIS_1_IP (the initial master), so there is one source of
# truth; the port follows REDIS_HA_NODE_PORT. After a failover Sentinel rewrites its
# runtime copy with the promoted IP, and a restarted Sentinel follows the replica's
# INFO back to the real master.
# Identity flags stay off: the topology is IP-based, so nothing has to be resolved.
# Enabling them reintroduces the hostname/tilt problem documented above.
REDIS_HA_RESOLVE_HOSTNAMES=no
REDIS_HA_ANNOUNCE_HOSTNAMES=no

# Per-node announced identity, empty by default so a node announces the IP it is
# reached from; redis-1/2/3 set it to their own pinned IP for a readable, stable
# Sentinel view. redis-node-entrypoint.sh only adds --replica-announce-ip/port when
# REDIS_HA_ANNOUNCE_IP is set.
REDIS_HA_ANNOUNCE_IP=
REDIS_HA_ANNOUNCE_PORT=

# Where the runtime Sentinel config lives. It must be a writable path: Sentinel
# rewrites its own config, so the read-only sentinel.conf.tpl is rendered into
# ${REDIS_HA_SENTINEL_DIR}/sentinel.conf on tmpfs at container start.
REDIS_HA_SENTINEL_DIR=/data
REDIS_HA_SENTINEL_TEMPLATE=/etc/redis/sentinel.conf.tpl
REDIS_HA_SENTINEL_CONF=/data/sentinel.conf
REDIS_HA_SENTINEL_PROTECTED_MODE=no

# Data-node behaviour. appendonly stays off: the topology is disposable demo data and
# tmpfs means no volume to clean up. maxmemory must stay below the mem_limit.
REDIS_HA_PROTECTED_MODE=no
REDIS_HA_APPENDONLY=no
REDIS_HA_MAXMEMORY=96mb
REDIS_HA_MAXMEMORY_POLICY=allkeys-lru
REDIS_HA_IDLE_TIMEOUT_SECONDS=0
REDIS_HA_TCP_KEEPALIVE_SECONDS=300

# Resource limits and the tmpfs backing /data.
REDIS_HA_NODE_MEM_LIMIT=128m
REDIS_HA_SENTINEL_MEM_LIMIT=64m
REDIS_HA_EXPORTER_MEM_LIMIT=48m
REDIS_HA_TMPFS_SIZE=32m

# Read-only Sentinel/replication viewer (code/lab/scripts/sentinel-status.sh).
# It never writes and never triggers a failover. Values may also be given as process
# environment variables, which take precedence.
SENTINEL_STATUS_DATA_CONTAINERS="jl-redis-1 jl-redis-2 jl-redis-3"
SENTINEL_STATUS_SENTINEL_CONTAINERS="jl-sentinel-1 jl-sentinel-2 jl-sentinel-3"
SENTINEL_STATUS_EXEC_TIMEOUT_SECONDS=5
SENTINEL_STATUS_WATCH_INTERVAL_SECONDS=2

# Sentinel assertions in verify.sh: auto runs them only when the first Sentinel
# container exists, off always skips them, on requires the ha profile to be up. The
# dev profile therefore prints one SKIP line and keeps its 97 PASS / 1 WARN baseline;
# under ha the guarded block only ever adds PASS lines (1 + 3 + 2 here).
REDIS_HA_VERIFY=auto
REDIS_HA_VERIFY_POLL_RETRIES=15
REDIS_HA_VERIFY_POLL_INTERVAL_SECONDS=2
# Topology shape the assertions expect: 3 Sentinels discovering each other
# (INFO sentinel's master0 line reports sentinels=REDIS_HA_EXPECTED_SENTINELS, itself
# included, and slaves=REDIS_HA_EXPECTED_REPLICAS) and 2 replicas following the master.
REDIS_HA_EXPECTED_SENTINELS=3
REDIS_HA_EXPECTED_REPLICAS=2

# --- App Sentinel CLIENT (compose profile "ha", Task M3-1b) ---------------------
# How the three app instances reach the topology above. Without these keys the
# ha profile still works: compose.ha.yml carries the same defaults inline.
#
# The app switches BOTH Redis stacks with one env var, REDIS_MODE, injected by
# the app overlays in compose.ha.yml (sentinel) and left unset by base/dev
# (application.yml default = standalone). Master discovery uses the NAME from
# REDIS_HA_MASTER_NAME, never an address.
#
# REDIS_SENTINEL_NODES is the ops-facing list of Sentinel endpoints
# (comma-separated host:port, resolvable from the app because the ha overlay
# joins jl-net). compose.ha.yml maps it - together with REDIS_HA_MASTER_NAME -
# onto Spring Boot's standard properties
# SPRING_DATA_REDIS_SENTINEL_MASTER / _NODES / _PASSWORD. They are NOT defaulted
# in application.yml on purpose: Boot evaluates spring.data.redis.sentinel.*
# eagerly (RedisConnectionConfiguration.determineMode), so an empty master name
# would fail every startup, dev included ("Sentinel Master Id must not be null
# or empty"). Consequence: an app run outside compose in sentinel mode must set
# those three SPRING_DATA_* properties itself.
# The compose default for this key is assembled from REDIS_HA_SENTINEL_PORT, so
# changing that port changes the endpoints as well (this line is the override,
# so if you change REDIS_HA_SENTINEL_PORT and keep this line, change it too).
REDIS_SENTINEL_NODES=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379

# App-side Redisson knobs for the ha demo (defaults live in application.yml;
# these env names are the override path per 工程规约 §1 - set them here only to
# deviate): SECKILL_REDISSON_MASTER_POOL_SIZE / _MASTER_MIN_IDLE /
# _SLAVE_POOL_SIZE / _SLAVE_MIN_IDLE / _SUBSCRIPTION_POOL_SIZE /
# _IDLE_CONNECTION_TIMEOUT_MS / _SCAN_INTERVAL_MS / _READ_MODE (default MASTER).
# The Redisson/Sentinel master-discovery log probe budget maps to
# REDIS_DISCOVERY_REPORT_ATTEMPTS / REDIS_DISCOVERY_REPORT_INTERVAL_MS.
#
# Network note (the M3-1a gotcha): the data nodes announce their pinned
# jl-sentinel-net IPs, which is what Sentinel returns to clients, so compose.ha
# .yml ALSO attaches jl-app-1/2/3 to jl-sentinel-net (ha render only; the
# default dev render keeps the single-network app containers unchanged).

# --- App MySQL CLIENT (MySQL Router, design §8.3) ------------------------------
# MYSQL_MODE switches the datasource endpoints of the three app instances,
# name-aligned with REDIS_MODE (design §3.3: the image never changes):
#   standalone (default) - both Hikari pools keep using the dev single-node
#                          `mysql` service, exactly as before;
#   router               - write pool -> DB_WRITE_URL (MySQL Router 6446,
#                          read-write, follows the current primary), read pool
#                          -> DB_READ_URL (Router 6447, read-only, load-balanced
#                          over the secondaries).
# Both URLs are REQUIRED in router mode: an empty value fails app startup with a
# message naming the missing env key - there is no silent fallback to the dev
# MySQL (same philosophy as REDIS_MODE=sentinel). They are ignored while the
# mode is standalone: the mode, not key presence, is the switch.
#
# The values below are empty on purpose. To route through the Router, bring the
# db-ha tier up first (`bash code/lab/scripts/db-ha-up.sh`, which also publishes
# 127.0.0.1:6446/6447 for host tools) and set, in this file:
#   MYSQL_MODE=router
#   DB_WRITE_URL=jdbc:mysql://mysql-router:6446/seckill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#   DB_READ_URL=jdbc:mysql://mysql-router:6447/seckill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Then recreate only the app containers (compose up -d app-1 app-2 app-3).
# Credentials never belong in a JDBC URL here: the app authenticates with
# MYSQL_USER / MYSQL_PASSWORD above.
MYSQL_MODE=standalone
DB_WRITE_URL=
DB_READ_URL=

# --- reset-lab.sh target resolution (Stage2 B0-06) ------------------------------
# reset-lab.sh resets the topology the stack actually runs: it reads MYSQL_MODE /
# REDIS_MODE above and cross-checks them against live containers (Router/nodes ->
# the InnoDB Cluster via mysql-router:6446 or the current PRIMARY per node;
# sentinel -> every running jl-redis-<n>). An unresolvable topology aborts with
# exit 2 before any change. These keys only OVERRIDE that for a single run;
# leave them unset for normal use (full list: reset-lab.sh --help).
#   RESET_MYSQL_MODE=          RESET_REDIS_MODE=        RESET_CONTAINER_PREFIX=jl-
#   RESET_MYSQL_HA_NODES="mysql-1 mysql-2 mysql-3"      RESET_REDIS_HA_NODES="redis-1 redis-2 redis-3"
#   RESET_MYSQL_ROUTER_CONTAINER=jl-mysql-router        RESET_MYSQL_ROUTER_HOST=mysql-router
#   RESET_MYSQL_ROUTER_RW_PORT=6446                     RESET_MYSQL_NODE_PORT=3306
#   RESET_REDIS_NODE_PORT=6379                          RESET_TOPOLOGY_PROBE_RETRIES=3
#   RESET_TOPOLOGY_PROBE_INTERVAL_SECONDS=2             RESET_MYSQL_CONNECT_TIMEOUT_SECONDS=5

# --- Stage2 B1-01 ledger (dedicated `lab_ledger` database) ---------------------
# Runs/operations/snapshots/fault events/audit rows live in the stack's MySQL,
# in a database physically separate from the business `seckill` schema. The
# controller creates the database, then Flyway applies db/ledger/V1. Standalone
# writes to `mysql:3306`; db-ha goes through MySQL Router `mysql-router:6446`
# (the SAME topology switch as the app tier and reset-lab: MYSQL_MODE).
#
# Account: root, because the business `seckill` account only owns seckill.* and
# cannot CREATE DATABASE. The controller already holds the Docker socket
# (root-equivalent), so this widens no boundary. The password follows
# MYSQL_ROOT_PASSWORD by default; leave LAB_LEDGER_PASSWORD unset unless the
# ledger must use a different root password. It never appears in a JDBC URL and
# is never logged.
#
# Defaults below are byte-identical to application.yml and the compose service
# environment. `LAB_LEDGER_MYSQL_MODE` is intentionally commented: the compose
# default is ${LAB_LEDGER_MYSQL_MODE:-${MYSQL_MODE:-standalone}}, so switching
# MYSQL_MODE=router for db-ha also switches the ledger.
LAB_LEDGER_ENABLED=true
# LAB_LEDGER_MYSQL_MODE=standalone
LAB_LEDGER_STANDALONE_URL=jdbc:mysql://mysql:3306/lab_ledger?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LAB_LEDGER_ROUTER_URL=jdbc:mysql://mysql-router:6446/lab_ledger?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LAB_LEDGER_SCHEMA=lab_ledger
LAB_LEDGER_USER=root
# LAB_LEDGER_PASSWORD=labroot
LAB_SOURCE_COMMIT=unknown
LAB_LEDGER_OPERATOR=local
LAB_LEDGER_MAX_POOL_SIZE=4
LAB_LEDGER_MIN_IDLE=1
LAB_LEDGER_CONNECTION_TIMEOUT_MS=3000
LAB_LEDGER_VALIDATION_TIMEOUT_MS=1000
# Retry CREATE DATABASE / Flyway while MySQL is unreachable.
LAB_LEDGER_BOOTSTRAP_RETRY_SECONDS=15
LAB_LEDGER_BOOTSTRAP_THREAD_NAME=ledger-bootstrap
LAB_LEDGER_FLYWAY_LOCATIONS=classpath:db/ledger
# Write-behind stash: named volume jl-ledger-stash-data, survives restarts.
LAB_LEDGER_STASH_DIR=/app/ledger-stash
LAB_LEDGER_STASH_MAX_FILES=500
LAB_LEDGER_STASH_MAX_BYTES=262144
LAB_LEDGER_STASH_REPLAY_INTERVAL_SECONDS=20
LAB_LEDGER_RETENTION_RUNS=50
LAB_LEDGER_RETENTION_INTERVAL_MINUTES=30
LAB_LEDGER_RECOVERY_ENABLED=true
LAB_LEDGER_QUERY_DEFAULT_LIMIT=50
LAB_LEDGER_QUERY_MAX_LIMIT=200
LAB_LEDGER_MAX_PAYLOAD_BYTES=65536
LAB_LEDGER_RUN_ID_MAX_ATTEMPTS=10
# B1-02 operation contract: one lab_operation row per environment-changing
# request. sync-wait-ms is the budget before the API answers 202
# PENDING_CONFIRMATION (keep it below the client timeout); the window decides how
# long the same Idempotency-Key replays the original operation; the lock TTL is
# the takeover escape hatch for a dead write run.
LAB_LEDGER_OPERATION_THREAD_NAME=ledger-operation
LAB_LEDGER_OPERATION_POOL_SIZE=2
LAB_LEDGER_OPERATION_SYNC_WAIT_MS=3000
LAB_LEDGER_IDEMPOTENCY_WINDOW_SECONDS=600
LAB_LEDGER_ENV_LOCK_KEY=env:write-run
LAB_LEDGER_ENV_LOCK_TTL_SECONDS=1800
LAB_LEDGER_ENV_LOCK_ACQUIRE_ATTEMPTS=3

# --- Stage2 B1-03 metrics aggregation (Prometheus window queries) --------------
# The controller may only name catalog keys; PromQL never comes from the client.
# Run windows are [runStart - scrape-grace, runEnd + drain-grace]. A metric with
# no series is NO_DATA/COLLECTING and a failed Prometheus query is DEGRADED -
# neither is ever rendered as 0. Grafana/Tempo links use the base addresses below;
# leaving the dashboard UID empty produces an Explore link instead of a panel.
# Defaults are byte-identical to application.yml and compose.base.yml.
LAB_METRICS_PROMETHEUS_URL=http://prometheus:9090
LAB_METRICS_CONNECT_TIMEOUT_SECONDS=2
LAB_METRICS_REQUEST_TIMEOUT_SECONDS=10
LAB_METRICS_SCRAPE_GRACE_SECONDS=15
LAB_METRICS_DRAIN_GRACE_SECONDS=30
LAB_METRICS_MAX_POINTS=300
LAB_METRICS_MIN_STEP_SECONDS=15
LAB_METRICS_MAX_SERIES=120
LAB_METRICS_MAX_KEYS=40
# Deep links are opened by the operator BROWSER: Grafana is published on the
# host (3000), so the link must be host-facing. Tempo 3200 is only exposed
# inside jl-net; publish it in compose before using the Tempo link.
LAB_METRICS_GRAFANA_URL=http://localhost:3000
LAB_METRICS_TEMPO_URL=http://tempo:3200
# LAB_METRICS_GRAFANA_DASHBOARD_UID=
LAB_METRICS_CATALOG_LOCATION=classpath:metrics/catalog.yml

# --- Stage2 B1-04 run pre-check (start gate) -----------------------------------
# POST /lab/runs/{runId}/start runs these checks BEFORE any state transition and
# BEFORE the write-run lock. A blocking finding answers 409/40903, keeps the run
# DRAFT and leaves no lock behind; there is NO force/skip setting. The report is
# also available from GET /lab/runs/{runId}/precheck (200 even when blocked).
# `enabled=false` disables the whole gate for ledger-only stacks, not one item.
# Memory rule: sum(mem_limit of running lab containers) + memory-reserve-mb must
# fit inside Docker Info.MemTotal. expected-app-image-id accepts the full id or
# an unambiguous prefix (e.g. the 12-char short id); blank checks agreement only.
LAB_PRECHECK_ENABLED=true
LAB_PRECHECK_TRAFFIC_CONTAINER=jl-traffic
LAB_PRECHECK_APP_CONTAINERS=jl-app-1,jl-app-2,jl-app-3
LAB_PRECHECK_PROMETHEUS_TIMEOUT_SECONDS=5
LAB_PRECHECK_REQUIRED_APP_TARGETS=3
LAB_PRECHECK_MEMORY_RESERVE_MB=1024
# LAB_PRECHECK_EXPECTED_APP_IMAGE_ID=
LAB_PRECHECK_MAX_LISTED_ITEMS=10
LAB_PRECHECK_CHECK_TIMEOUT_SECONDS=30

# --- Toxiproxy network-fault tier (compose profile "chaos-proxy") --------------
# Design §3.1/§3.3/§11.3: ONE Toxiproxy sits between the app tier and
# Redis/MySQL so the chaos-controller can inject latency, bandwidth limits,
# outages and recovery on those links. It is disabled by default and only ever
# loaded by `up.sh --profile chaos-proxy` (compose.base.yml + compose.dev.yml +
# compose.toxiproxy.yml). It is a DEV-STACK overlay and does NOT combine with
# the "ha" / "db-ha" profiles.
#
# The switch is decided when the app containers START: under this profile
# jl-app-1/2/3 are recreated against toxiproxy:16379 (Redis) and
# toxiproxy:13306 (MySQL), so run it in demo preparation, never mid-drill.
# Going back needs `up.sh --profile dev` (or down + up) to recreate the app tier
# against the datastores again. MYSQL_MODE stays standalone; the overlay
# repoints the two standalone Hikari URLs itself, so no other key changes.
#
# Pinned image (Docker Hub mirror of ghcr.io/shopify/toxiproxy:2.9.0). The
# one-shot init job reuses this same image - it needs no second tag.
TOXIPROXY_INIT_IMAGE=alpine:3.19
TOXIPROXY_IMAGE=shopify/toxiproxy:2.9.0
# Control API / toxiproxy-cli port. Published on 127.0.0.1 only; in-network
# callers use http://toxiproxy:<port>.
TOXIPROXY_API_PORT=8474
# Proxy listen ports inside jl-net. Not published on the host: the app reaches
# them as toxiproxy:16379 / toxiproxy:13306. Redis 6379 and MySQL 3306 on the
# datastores themselves are untouched.
TOXIPROXY_REDIS_PORT=16379
TOXIPROXY_MYSQL_PORT=13306
# Resource limits (design §3.1 budget: 64MB for Toxiproxy). The init job is
# one-shot and exits 0 after creating/updating the two proxies.
TOXIPROXY_MEM_LIMIT=64m
TOXIPROXY_INIT_MEM_LIMIT=32m
# chaos-controller -> Toxiproxy API base URL (env key CHAOS_TOXIPROXY_URL). The
# Java toxiproxy actions read exactly this key; keep it pointing at
# TOXIPROXY_API_PORT. Only injected in the chaos-proxy render - absent in
# dev/ha, which is what tells the actions the tier is not enabled.
CHAOS_TOXIPROXY_URL=http://toxiproxy:8474

# --- HA acceptance script (code/lab/scripts/ha-acceptance.sh) -------------------
# Optional, script-only overrides. The script reads this file key-by-key (never
# sources it) and its process environment wins. Defaults match the step-24d/31
# drills (TTL 45s, 15s Nginx recovery threshold); uncomment only to deviate.
# The full table is in doc/process/Stage1/step-45-ha-acceptance-script.md.
# HA_ACCEPT_SENTINEL_TTL_SECONDS=45
# HA_ACCEPT_SENTINEL_PROMOTION_BUDGET_SECONDS=60
# HA_ACCEPT_SENTINEL_REJOIN_BUDGET_SECONDS=120
# HA_ACCEPT_MYSQL_TTL_SECONDS=45
# HA_ACCEPT_MYSQL_PROMOTION_BUDGET_SECONDS=90
# HA_ACCEPT_MYSQL_REJOIN_BUDGET_SECONDS=180
# HA_ACCEPT_MYSQL_REQUIRE_ROUTER_MODE=true
# HA_ACCEPT_HTTP_RECOVERY_THRESHOLD_SECONDS=15
# HA_ACCEPT_HTTP_RECOVERY_BUDGET_SECONDS=30
# HA_ACCEPT_POLL_INTERVAL_SECONDS=2
# HA_ACCEPT_SENTINEL_TARGET=auto
# HA_ACCEPT_MYSQL_TARGET=auto
# HA_ACCEPT_MYSQL_PROBE_CONTAINER=auto
#
# Controller-side MySQL cluster probe (step-47). All keys map 1:1 to
# chaos.mysql-cluster.* in application.yml and are forwarded to the controller
# by compose.base.yml, so setting one here takes effect on the next
# `compose up -d chaos-controller` (no rebuild needed). The query SQL and the
# exec argv are image config, not env.
#
# CHAOS_MYSQL_CLUSTER_CONTAINER is the node the probe execs into. The code
# default is jl-mysql-1, but the compose default (used when this key is absent)
# is jl-mysql-3: jl-mysql-1 is the usual failover-drill kill target, and a probe
# sitting on the killed node reports probe_up=0 for the whole drill instead of
# the failover. Any fixed node can become PRIMARY after a later failover; the
# controller then logs one WARN per state change (a drill killing that node will
# blind the probe). Uncomment to probe a different member.
# CHAOS_MYSQL_CLUSTER_ENABLED=true
# CHAOS_MYSQL_CLUSTER_INTERVAL_SECONDS=10
# CHAOS_MYSQL_CLUSTER_CONTAINER=jl-mysql-3
# CHAOS_MYSQL_CLUSTER_ADMIN_USER=root
# The probe never carries the password: it expands this variable inside the
# node's own environment, so the value must exist on every db-ha node.
# CHAOS_MYSQL_CLUSTER_PASSWORD_ENV_VAR=MYSQL_ROOT_PASSWORD
# Must stay <= CHAOS_MYSQL_CLUSTER_INTERVAL_SECONDS (validated at startup).
# CHAOS_MYSQL_CLUSTER_EXEC_TIMEOUT_SECONDS=6
# Healthy group size; a different observed count logs one WARN per change.
# CHAOS_MYSQL_CLUSTER_EXPECTED_MEMBER_COUNT=3
# CHAOS_MYSQL_CLUSTER_THREAD_NAME=mysql-cluster-probe
# CHAOS_MYSQL_CLUSTER_SHUTDOWN_TIMEOUT_SECONDS=5
# B0-08 slice B: on a failed probe, inspect the probe container once to tell
# "node/MySQL answered wrongly" from "the drill killed the observer" (the
# mysql_cluster_* series freeze). One extra inspect per failed tick; set false
# to silence the check on stacks where even that is too chatty.
# CHAOS_MYSQL_CLUSTER_FAILURE_CONTAINER_CHECK_ENABLED=true

# Narrow app proxy (Stage2 B0-05). Each key maps 1:1 to chaos.app-proxy.* in
# the controller's application.yml and compose.base.yml forwards it with the
# SAME default, so uncommenting one here takes effect on the next
# `compose up -d chaos-controller` (no rebuild). Body over the cap is refused
# 413/41301; an over-size upstream answer is refused 502/50202 (never
# truncated). B3 key-list pages must stay under MAX_RESPONSE_BYTES or raise
# it here first. Static check: scripts/test-chaos-env-wiring.sh.
# CHAOS_APP_PROXY_INSTANCES=app-1,app-2,app-3
# CHAOS_APP_PROXY_SCHEME=http
# CHAOS_APP_PROXY_PORT=8080
# CHAOS_APP_PROXY_CONNECT_TIMEOUT_SECONDS=2
# Seed runs synchronously in the app; keep it above the worst-case seed time.
# CHAOS_APP_PROXY_REQUEST_TIMEOUT_SECONDS=10
# CHAOS_APP_PROXY_MAX_REQUEST_BYTES=8192
# CHAOS_APP_PROXY_MAX_RESPONSE_BYTES=2097152


# ---------------------------------------------------------------------------
# 缓存族 LAB_CACHE_* (Stage2 B0-04). 每个键对应 app.lab.cache.* 的一条配置，
# 注释值就是 application.yml 的默认值；取消注释即覆盖，不改镜像、不重新构建。
# 生效值可用 GET /lab/config 的 cacheConfig 回读（值 + 来源 + 默认值），
# compose.base.yml 的 app 服务已按 ${VAR:default} 接线同一批键。
#
# L2 = TwoLevelCache 的 Redis 写侧（此前是 Java 常量：5 分钟 TTL、"cache:" 前缀、
# clear() 的 SCAN count 500）。键前缀是 L2 的键布局契约：缓存本体、实验播种、
# GET /lab/cache/state、预热服务与 TTL 抖动都从同一键解析，改一处全体一致。
# LAB_CACHE_L2_TTL_SECONDS=300
# LAB_CACHE_L2_KEY_PREFIX=cache:
# LAB_CACHE_L2_CLEAR_SCAN_COUNT=500
#
# 防护模式启动种子（运行期用 POST /lab/cache/mode 切换，无需重启）。
# LAB_CACHE_DEFENSE_MODE=off
# 空值缓存（穿透）：标记键前缀 / TTL / TTL 抖动秒数。
# LAB_CACHE_NULL_KEY_PREFIX=null:product:
# LAB_CACHE_NULL_TTL_SECONDS=10
# LAB_CACHE_NULL_JITTER_SECONDS=5
# 布隆过滤器（穿透）：键名 / 预期插入量 / 假阳性率。
# LAB_CACHE_BLOOM_KEY=bloom:product-ids
# LAB_CACHE_BLOOM_EXPECTED_INSERTIONS=10000
# LAB_CACHE_BLOOM_FALSE_PROBABILITY=0.01
#
# 击穿：mutex 锁（前缀 / 等待毫秒 / 租约毫秒 / 超时后行为 db|stale，
# lease-ms 必须 >= wait-ms，启动校验）。
# LAB_CACHE_MUTEX_KEY_PREFIX=lock:product:
# LAB_CACHE_MUTEX_WAIT_MS=200
# LAB_CACHE_MUTEX_LEASE_MS=2000
# LAB_CACHE_MUTEX_ON_LOCK_TIMEOUT=db
# 击穿：logical-expire（逻辑 TTL / 物理保留 / 上限 / 异步刷新线程池；
# retention-seconds 必须同时大于 logical-ttl-seconds 与热键 TTL）。
# LAB_CACHE_LOGICAL_TTL_SECONDS=30
# LAB_CACHE_LOGICAL_RETENTION_SECONDS=600
# LAB_CACHE_LOGICAL_MAX_ENTRIES=10000
# LAB_CACHE_LOGICAL_REFRESH_POOL_SIZE=2
# LAB_CACHE_LOGICAL_REFRESH_QUEUE_CAPACITY=100
# LAB_CACHE_LOGICAL_REFRESH_KEEP_ALIVE_SECONDS=60
# LAB_CACHE_LOGICAL_REFRESH_THREAD_PREFIX=breakdown-refresh
#
# 雪崩：ttl-jitter 百分比；l1-cache 刷新间隔/陈旧窗口/上限/刷新池；
# db-fallback 熔断降级的 permits/period-ms。
# LAB_CACHE_TTL_JITTER_PERCENT=20
# LAB_CACHE_L1_REFRESH_INTERVAL_SECONDS=10
# LAB_CACHE_L1_STALE_WINDOW_SECONDS=60
# LAB_CACHE_L1_MAX_ENTRIES=10000
# LAB_CACHE_L1_REFRESH_POOL_SIZE=2
# LAB_CACHE_L1_REFRESH_QUEUE_CAPACITY=100
# LAB_CACHE_L1_KEEP_ALIVE_SECONDS=60
# LAB_CACHE_L1_REFRESH_THREAD_PREFIX=avalanche-l1-refresh
# LAB_CACHE_DB_FALLBACK_PERMITS=50
# LAB_CACHE_DB_FALLBACK_PERIOD_MS=1000
#
# 预热（M4-3）与 L1 尺寸：L1 容量/刷新/写过期与 B0-03 的 stats 导出开关。
# LAB_CACHE_PREHEAT_ENABLED=true
# LAB_CACHE_PREHEAT_TOP_N=200
# LAB_CACHE_PREHEAT_HOT_LIST_KEY=hot:products
# LAB_CACHE_PREHEAT_TRACKER_CAPACITY=100000
# LAB_CACHE_PREHEAT_TRACKER_DECAY_INTERVAL_SECONDS=30
# LAB_CACHE_PREHEAT_TRACKER_FLUSH_INTERVAL_SECONDS=10
# LAB_CACHE_PREHEAT_LOAD_CHUNK_SIZE=50
# LAB_CACHE_PREHEAT_LOAD_CHUNK_PAUSE_MS=50
# LAB_CACHE_PREHEAT_STARTUP_DELAY_MS=1000
# LAB_CACHE_PREHEAT_PERIODIC_INTERVAL_SECONDS=300
# LAB_CACHE_PREHEAT_SCHEDULER_POOL_SIZE=1
# LAB_CACHE_PREHEAT_THREAD_PREFIX=cache-preheat
# LAB_CACHE_L1_MAXIMUM_SIZE=10000
# LAB_CACHE_L1_REFRESH_AFTER_WRITE_SECONDS=10
# LAB_CACHE_L1_EXPIRE_AFTER_WRITE_SECONDS=60
# LAB_CACHE_L1_MICROMETER_STATS_ENABLED=true
#
# 实验数据集播种与状态视图（start-id 必须大于 protected-max-id）。
# LAB_CACHE_SEED_PRODUCT_COUNT=1000
# LAB_CACHE_SEED_START_ID=90000
# LAB_CACHE_SEED_PROTECTED_MAX_ID=1000
# LAB_CACHE_SEED_AVALANCHE_KEY_COUNT=200
# LAB_CACHE_SEED_AVALANCHE_TTL_SECONDS=60
# LAB_CACHE_SEED_HOT_KEY_INDEX=999
# LAB_CACHE_SEED_HOT_KEY_TTL_SECONDS=300
# LAB_CACHE_SEED_WRITE_BATCH_SIZE=200
# LAB_CACHE_SEED_NAME_PREFIX=实验商品
# LAB_CACHE_SEED_STATUS=ON_SALE
# LAB_CACHE_SEED_PRICE=99.00
# LAB_CACHE_STATE_SCAN_COUNT=500
