# Copy to .env (up.sh does this automatically if .env is missing).
# Lab-only defaults. Never use these credentials outside the local demo.

COMPOSE_PROJECT_NAME=java-learn-lab
TZ=UTC

NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.4
REDIS_IMAGE=redis:7.4.2-alpine
RABBITMQ_IMAGE=rabbitmq:4.1.0-management
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.16.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.0
PROMETHEUS_IMAGE=prom/prometheus:v3.0.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
TEMPO_IMAGE=grafana/tempo:2.6.0
# Candidate tag 0.115.0 could not be pulled through the local registry mirror;
# 0.116.1 is the nearest tag that pulls and runs with the same config schema.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.116.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# OTel Java agent baked into java-learn-lab/seckill-app:jdk21 from Maven Central.
OTEL_AGENT_VERSION=2.10.0

MYSQL_ROOT_PASSWORD=labroot
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=seckill

# Lab-only account for jl-mysqld-exporter. The database-side password is fixed in
# mysql/init/00-exporter.sql: changing this value requires updating that SQL file too.
MYSQLD_EXPORTER_PASSWORD=exporter

RABBITMQ_DEFAULT_USER=lab
RABBITMQ_DEFAULT_PASS=lab

# Lab-only Grafana admin. Also used by verify.sh for the Grafana APIs.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=labadmin

# Shared secret for the lab console API (sent as X-Lab-Token). Local demo only;
# changing it requires restarting chaos-controller and updating the console token.
LAB_TOKEN=lab-token

# Chaos-controller target policy (Task 22b / M3-1c). The compose defaults are
# already demo-ready; set these only to narrow/widen them for a specific run.
# CHAOS_GUIDE_TARGET_PATTERN is a whole-name match for scenario targets: apps
# plus the HA Redis data nodes, never the Sentinel containers.
CHAOS_GUIDE_TARGET_PATTERN=^jl-(app|redis)-[0-9]$
# Datastore allow-list: closed by default in the code (empty = every
# mysql/redis/rabbit/mongo/postgres target is refused). The lab ships exactly
# the three HA Sentinel data nodes plus the three HA MySQL nodes (the step-31
# Router/failover drill needs to kill jl-mysql-1); whole-name matching keeps
# the dev single nodes `jl-redis` and `jl-mysql`, the exporters, jl-redis-10
# and jl-mysql-10 out. Do NOT widen this to `jl-redis`, `jl-mysql`, a bare
# `.*` or a loose substring in a delivered config.
CHAOS_DATASTORE_ALLOWED_TARGET_PATTERN=^jl-(redis|mysql)-[1-3]$

# Runtime experiment toggles (Task 17). These seed each app instance; a runtime
# POST /lab/toggles changes only the instance that received it until the
# chaos-controller broadcast lands. Local demo only.
LAB_TOGGLE_LOCK=true
LAB_TOGGLE_IDEMPOTENCY=true
LAB_TOGGLE_MQ=true
LAB_TOGGLE_RATELIMIT=true
LAB_TOGGLE_CIRCUITBREAKER=true
LAB_TOGGLE_CACHE=true

# Order-accept SLO buckets (Task 18). Comma-separated Micrometer durations used
# by management.metrics.distribution for order_accept_seconds; D4 reads the
# exported histogram buckets. Change here to widen/narrow the SLO set.
ORDER_ACCEPT_SLO=50ms,100ms,300ms,500ms,1s,2s

# Full-stack smoke (code/lab/scripts/smoke.sh). Process environment overrides
# these values; an explicit SMOKE_LAB_TOKEN falls back to LAB_TOKEN. Product 20
# is reserved for the async seckill path, product 1 for synchronous orders.
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_PRODUCT_ID=1
SMOKE_SECKILL_PRODUCT_ID=20
SMOKE_USER=smoke-user
SMOKE_TIMEOUT_SECONDS=10
SMOKE_POLL_RETRIES=30
SMOKE_POLL_INTERVAL_SECONDS=1

# --- Redis Sentinel topology (compose profile "ha", Task M3-1a) -----------------
# Only used by `up.sh --profile ha` / compose.ha.yml. The dev profile keeps the
# single-node jl-redis untouched, so nothing here affects the default stack.
# Budget check (design doc §3.1, ~800MB for 1 master + 2 replicas + 3 Sentinels
# plus one exporter per data node): 3x128m + 3x64m + 3x48m = 720m.

# Kept identical to REDIS_IMAGE so the ha profile pulls nothing new; if you bump
# REDIS_IMAGE, bump this one too (or point it at a tag already present locally).
REDIS_HA_IMAGE=redis:7.4.2-alpine

# Master name the Sentinels monitor and the app asks for (design §8.2: mymaster).
REDIS_HA_MASTER_NAME=mymaster

# Container-internal ports. Host ports are NOT published by default: the topology
# is jl-net-only (see the commented ports: block in compose.ha.yml for the demo
# override, which defaults to 6380-6382 / 26380-26382 so it cannot collide with
# dev's 127.0.0.1:6379).
REDIS_HA_NODE_PORT=6379
REDIS_HA_SENTINEL_PORT=26379

# Single lab password for the whole HA group: applied as requirepass + masterauth on
# every data node and as `sentinel auth-pass` on every Sentinel. masterauth is what
# lets a demoted old master rejoin as a replica after a failover. Lab-only value.
REDIS_HA_REQUIRE_AUTH=true
REDIS_HA_PASSWORD=labredis

# Sentinel election knobs. quorum 2 of 3 Sentinels; down-after 5s and a 15s failover
# budget keep the drill watchable (~5-20s from `docker stop` to the new master).
REDIS_HA_QUORUM=2
REDIS_HA_DOWN_AFTER_MS=5000
REDIS_HA_PARALLEL_SYNC=1
REDIS_HA_FAILOVER_TIMEOUT_MS=15000

# Pinned addresses on the Sentinel-only network (compose.ha.yml -> jl-sentinel-net).
# Sentinel monitors and replicates by IP on purpose: the moment a container stops,
# its compose DNS name disappears from Docker's embedded DNS, and a Sentinel that was
# configured with that name logs "Failed to resolve hostname", enters #tilt mode and
# refuses to promote anybody (measured in the M3-1a drill). A pinned IP is stable
# across `docker stop`/`docker start`/recreate, so the failover and the old master
# rejoining as a replica both work. Keep the /24 hosts inside REDIS_HA_SUBNET and
# change the subnet (not just the hosts) if it collides on your machine.
REDIS_HA_SUBNET=172.28.190.0/24
REDIS_HA_REDIS_1_IP=172.28.190.11
REDIS_HA_REDIS_2_IP=172.28.190.12
REDIS_HA_REDIS_3_IP=172.28.190.13
REDIS_HA_SENTINEL_1_IP=172.28.190.21
REDIS_HA_SENTINEL_2_IP=172.28.190.22
REDIS_HA_SENTINEL_3_IP=172.28.190.23

# Address written into `sentinel monitor` and into the replicas' --replicaof: compose
# wires both from REDIS_HA_REDIS_1_IP (the initial master), so there is one source of
# truth; the port follows REDIS_HA_NODE_PORT. After a failover Sentinel rewrites its
# runtime copy with the promoted IP, and a restarted Sentinel follows the replica's
# INFO back to the real master.
# Identity flags stay off: the topology is IP-based, so nothing has to be resolved.
# Enabling them reintroduces the hostname/tilt problem documented above.
REDIS_HA_RESOLVE_HOSTNAMES=no
REDIS_HA_ANNOUNCE_HOSTNAMES=no

# Per-node announced identity, empty by default so a node announces the IP it is
# reached from; redis-1/2/3 set it to their own pinned IP for a readable, stable
# Sentinel view. redis-node-entrypoint.sh only adds --replica-announce-ip/port when
# REDIS_HA_ANNOUNCE_IP is set.
REDIS_HA_ANNOUNCE_IP=
REDIS_HA_ANNOUNCE_PORT=

# Where the runtime Sentinel config lives. It must be a writable path: Sentinel
# rewrites its own config, so the read-only sentinel.conf.tpl is rendered into
# ${REDIS_HA_SENTINEL_DIR}/sentinel.conf on tmpfs at container start.
REDIS_HA_SENTINEL_DIR=/data
REDIS_HA_SENTINEL_TEMPLATE=/etc/redis/sentinel.conf.tpl
REDIS_HA_SENTINEL_CONF=/data/sentinel.conf
REDIS_HA_SENTINEL_PROTECTED_MODE=no

# Data-node behaviour. appendonly stays off: the topology is disposable demo data and
# tmpfs means no volume to clean up. maxmemory must stay below the mem_limit.
REDIS_HA_PROTECTED_MODE=no
REDIS_HA_APPENDONLY=no
REDIS_HA_MAXMEMORY=96mb
REDIS_HA_MAXMEMORY_POLICY=allkeys-lru
REDIS_HA_IDLE_TIMEOUT_SECONDS=0
REDIS_HA_TCP_KEEPALIVE_SECONDS=300

# Resource limits and the tmpfs backing /data.
REDIS_HA_NODE_MEM_LIMIT=128m
REDIS_HA_SENTINEL_MEM_LIMIT=64m
REDIS_HA_EXPORTER_MEM_LIMIT=48m
REDIS_HA_TMPFS_SIZE=32m

# Read-only Sentinel/replication viewer (code/lab/scripts/sentinel-status.sh).
# It never writes and never triggers a failover. Values may also be given as process
# environment variables, which take precedence.
SENTINEL_STATUS_DATA_CONTAINERS="jl-redis-1 jl-redis-2 jl-redis-3"
SENTINEL_STATUS_SENTINEL_CONTAINERS="jl-sentinel-1 jl-sentinel-2 jl-sentinel-3"
SENTINEL_STATUS_EXEC_TIMEOUT_SECONDS=5
SENTINEL_STATUS_WATCH_INTERVAL_SECONDS=2

# Sentinel assertions in verify.sh: auto runs them only when the first Sentinel
# container exists, off always skips them, on requires the ha profile to be up. The
# dev profile therefore prints one SKIP line and keeps its 97 PASS / 1 WARN baseline;
# under ha the guarded block only ever adds PASS lines (1 + 3 + 2 here).
REDIS_HA_VERIFY=auto
REDIS_HA_VERIFY_POLL_RETRIES=15
REDIS_HA_VERIFY_POLL_INTERVAL_SECONDS=2
# Topology shape the assertions expect: 3 Sentinels discovering each other
# (INFO sentinel's master0 line reports sentinels=REDIS_HA_EXPECTED_SENTINELS, itself
# included, and slaves=REDIS_HA_EXPECTED_REPLICAS) and 2 replicas following the master.
REDIS_HA_EXPECTED_SENTINELS=3
REDIS_HA_EXPECTED_REPLICAS=2

# --- App Sentinel CLIENT (compose profile "ha", Task M3-1b) ---------------------
# How the three app instances reach the topology above. Without these keys the
# ha profile still works: compose.ha.yml carries the same defaults inline.
#
# The app switches BOTH Redis stacks with one env var, REDIS_MODE, injected by
# the app overlays in compose.ha.yml (sentinel) and left unset by base/dev
# (application.yml default = standalone). Master discovery uses the NAME from
# REDIS_HA_MASTER_NAME, never an address.
#
# REDIS_SENTINEL_NODES is the ops-facing list of Sentinel endpoints
# (comma-separated host:port, resolvable from the app because the ha overlay
# joins jl-net). compose.ha.yml maps it - together with REDIS_HA_MASTER_NAME -
# onto Spring Boot's standard properties
# SPRING_DATA_REDIS_SENTINEL_MASTER / _NODES / _PASSWORD. They are NOT defaulted
# in application.yml on purpose: Boot evaluates spring.data.redis.sentinel.*
# eagerly (RedisConnectionConfiguration.determineMode), so an empty master name
# would fail every startup, dev included ("Sentinel Master Id must not be null
# or empty"). Consequence: an app run outside compose in sentinel mode must set
# those three SPRING_DATA_* properties itself.
# The compose default for this key is assembled from REDIS_HA_SENTINEL_PORT, so
# changing that port changes the endpoints as well (this line is the override,
# so if you change REDIS_HA_SENTINEL_PORT and keep this line, change it too).
REDIS_SENTINEL_NODES=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379

# App-side Redisson knobs for the ha demo (defaults live in application.yml;
# these env names are the override path per 工程规约 §1 - set them here only to
# deviate): SECKILL_REDISSON_MASTER_POOL_SIZE / _MASTER_MIN_IDLE /
# _SLAVE_POOL_SIZE / _SLAVE_MIN_IDLE / _SUBSCRIPTION_POOL_SIZE /
# _IDLE_CONNECTION_TIMEOUT_MS / _SCAN_INTERVAL_MS / _READ_MODE (default MASTER).
# The Redisson/Sentinel master-discovery log probe budget maps to
# REDIS_DISCOVERY_REPORT_ATTEMPTS / REDIS_DISCOVERY_REPORT_INTERVAL_MS.
#
# Network note (the M3-1a gotcha): the data nodes announce their pinned
# jl-sentinel-net IPs, which is what Sentinel returns to clients, so compose.ha
# .yml ALSO attaches jl-app-1/2/3 to jl-sentinel-net (ha render only; the
# default dev render keeps the single-network app containers unchanged).

# --- App MySQL CLIENT (MySQL Router, design §8.3) ------------------------------
# MYSQL_MODE switches the datasource endpoints of the three app instances,
# name-aligned with REDIS_MODE (design §3.3: the image never changes):
#   standalone (default) - both Hikari pools keep using the dev single-node
#                          `mysql` service, exactly as before;
#   router               - write pool -> DB_WRITE_URL (MySQL Router 6446,
#                          read-write, follows the current primary), read pool
#                          -> DB_READ_URL (Router 6447, read-only, load-balanced
#                          over the secondaries).
# Both URLs are REQUIRED in router mode: an empty value fails app startup with a
# message naming the missing env key - there is no silent fallback to the dev
# MySQL (same philosophy as REDIS_MODE=sentinel). They are ignored while the
# mode is standalone: the mode, not key presence, is the switch.
#
# The values below are empty on purpose. To route through the Router, bring the
# db-ha tier up first (`bash code/lab/scripts/db-ha-up.sh`, which also publishes
# 127.0.0.1:6446/6447 for host tools) and set, in this file:
#   MYSQL_MODE=router
#   DB_WRITE_URL=jdbc:mysql://mysql-router:6446/seckill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#   DB_READ_URL=jdbc:mysql://mysql-router:6447/seckill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Then recreate only the app containers (compose up -d app-1 app-2 app-3).
# Credentials never belong in a JDBC URL here: the app authenticates with
# MYSQL_USER / MYSQL_PASSWORD above.
MYSQL_MODE=standalone
DB_WRITE_URL=
DB_READ_URL=

