# Copy to .env (up.sh does this automatically if .env is missing).
# Lab-only defaults. Never use these credentials outside the local demo.

COMPOSE_PROJECT_NAME=java-learn-lab
TZ=UTC

NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.4
REDIS_IMAGE=redis:7.4.2-alpine
RABBITMQ_IMAGE=rabbitmq:4.1.0-management
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.16.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.4.0
PROMETHEUS_IMAGE=prom/prometheus:v3.0.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
TEMPO_IMAGE=grafana/tempo:2.6.0
# Candidate tag 0.115.0 could not be pulled through the local registry mirror;
# 0.116.1 is the nearest tag that pulls and runs with the same config schema.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.116.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# OTel Java agent baked into java-learn-lab/seckill-app:jdk21 from Maven Central.
OTEL_AGENT_VERSION=2.10.0

MYSQL_ROOT_PASSWORD=labroot
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=seckill

# Lab-only account for jl-mysqld-exporter. The database-side password is fixed in
# mysql/init/00-exporter.sql: changing this value requires updating that SQL file too.
MYSQLD_EXPORTER_PASSWORD=exporter

RABBITMQ_DEFAULT_USER=lab
RABBITMQ_DEFAULT_PASS=lab

# Lab-only Grafana admin. Also used by verify.sh for the Grafana APIs.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=labadmin

# Shared secret for the lab console API (sent as X-Lab-Token). Local demo only;
# changing it requires restarting chaos-controller and updating the console token.
LAB_TOKEN=lab-token

# Runtime experiment toggles (Task 17). These seed each app instance; a runtime
# POST /lab/toggles changes only the instance that received it until the
# chaos-controller broadcast lands. Local demo only.
LAB_TOGGLE_LOCK=true
LAB_TOGGLE_IDEMPOTENCY=true
LAB_TOGGLE_MQ=true
LAB_TOGGLE_RATELIMIT=true
LAB_TOGGLE_CIRCUITBREAKER=true
LAB_TOGGLE_CACHE=true

# Order-accept SLO buckets (Task 18). Comma-separated Micrometer durations used
# by management.metrics.distribution for order_accept_seconds; D4 reads the
# exported histogram buckets. Change here to widen/narrow the SLO set.
ORDER_ACCEPT_SLO=50ms,100ms,300ms,500ms,1s,2s

# Full-stack smoke (code/lab/scripts/smoke.sh). Process environment overrides
# these values; an explicit SMOKE_LAB_TOKEN falls back to LAB_TOKEN. Product 20
# is reserved for the async seckill path, product 1 for synchronous orders.
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_PRODUCT_ID=1
SMOKE_SECKILL_PRODUCT_ID=20
SMOKE_USER=smoke-user
SMOKE_TIMEOUT_SECONDS=10
SMOKE_POLL_RETRIES=30
SMOKE_POLL_INTERVAL_SECONDS=1
