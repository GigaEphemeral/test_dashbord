# DB-HA tier variables (MySQL InnoDB Cluster + MySQL Router), step 25a.
#
# Copy to .env, or append to an existing .env:
#   grep -E '^[A-Z]' code/lab/docker/.env.mysql.example >> code/lab/docker/.env
# then edit the values. Nothing here is required by the always-on dev stack:
# compose.mysql.yml gives every key a default except MYSQL_HA_CLUSTER_GROUP_NAME.
#
# Lab-only credentials, same policy as .env.example. Never reuse them elsewhere.
#
# Consumption model (工程规约 §1 - no literal values in compose or scripts):
#   process environment  >  code/lab/docker/.env  >  the ${VAR:-default} in
#   compose.mysql.yml / db-ha-*.sh / db-cluster-status.sh

# --- required: Group Replication identity ------------------------------------
# The UUID every node agrees on. No default on purpose: a per-machine value keeps
# two labs from ever joining each other's group. db-ha-up.sh refuses to start if it
# is missing or is not a UUID. Generate: uuidgen, or any UUID v1/v4 tool.
MYSQL_HA_CLUSTER_GROUP_NAME=

# --- images and binaries -----------------------------------------------------
# MYSQL_IMAGE (already in .env.example) is reused for the three nodes AND for the
# cluster bootstrap job, because mysql:8.4.4 ships MySQL Shell 8.4.4. The Router is
# the only new pull; if the local registry mirror cannot serve this tag, point
# MYSQL_HA_ROUTER_IMAGE at any router tag present on the machine (`docker images`).
MYSQL_HA_ROUTER_IMAGE=mysql/mysql-router:8.4.4
# Overrides MYSQL_IMAGE for the bootstrap job only. Left commented on purpose: an
# empty/absent value inherits MYSQL_IMAGE, so the server image stays one key.
#MYSQL_HA_INIT_IMAGE=
# Interpreter used for the three entrypoint scripts and the binaries they call.
MYSQL_HA_SHELL_BIN=bash
MYSQL_HA_MYSQLSH_BIN=mysqlsh
MYSQL_HA_MYSQL_BIN=mysql
MYSQL_HA_MYSQLROUTER_BIN=mysqlrouter

# --- where the assets live inside the containers -----------------------------
# compose.mysql.yml bind-mounts code/lab/docker/mysql-cluster here (read-only).
MYSQL_HA_ASSET_DIR=/lab/mysql-cluster
# Rendered per-node option file. MySQL requires --defaults-extra-file to be the
# first argument, so the path is set in exactly one place (the node's command:).
MYSQL_HA_NODE_CONF_FILE=/var/lib/mysql-lab/node.cnf
# Only needed when the template lives elsewhere: compose derives
# ${MYSQL_HA_ASSET_DIR}/conf/node.cnf.tpl, so leave this unset for the normal case.
#MYSQL_HA_NODE_TEMPLATE=

# --- per-node identity (must differ on every node) ---------------------------
# server_id: GR refuses two members with the same id, and it is also the GTID
# source id. report_host: MUST be the compose service name - Docker Desktop hands
# out new IPs on every recreate, and GR would then be unable to rejoin a member.
MYSQL_HA_MYSQL_1_HOST=mysql-1
MYSQL_HA_MYSQL_2_HOST=mysql-2
MYSQL_HA_MYSQL_3_HOST=mysql-3
MYSQL_HA_MYSQL_1_SERVER_ID=1
MYSQL_HA_MYSQL_2_SERVER_ID=2
MYSQL_HA_MYSQL_3_SERVER_ID=3
# Higher weight wins the primary election after a failover (100 = equal, so the
# current primary tends to stay primary - set mysql-1 higher to pin it back).
MYSQL_HA_MYSQL_1_MEMBER_WEIGHT=100
MYSQL_HA_MYSQL_2_MEMBER_WEIGHT=100
MYSQL_HA_MYSQL_3_MEMBER_WEIGHT=100

# --- ports and memory --------------------------------------------------------
# In-cluster MySQL port and the Group Replication communication port. Neither node
# port is published to the host; only the Router is.
MYSQL_HA_NODE_PORT=3306
MYSQL_HA_GR_LOCAL_PORT=33061
# ~640m x 3 + router + exporters + init job ~= the 1.8GB budget of design §3.1.
# Lower it together with MYSQL_HA_INNODB_BUFFER_POOL_SIZE on a tight machine.
MYSQL_HA_NODE_MEM_LIMIT=640m
MYSQL_HA_EXPORTER_MEM_LIMIT=48m
MYSQL_HA_INIT_MEM_LIMIT=128m
MYSQL_HA_ROUTER_MEM_LIMIT=64m

# --- Group Replication behaviour --------------------------------------------
# Seed list; empty = composed from the three host keys by node-entrypoint.sh.
# Set it only to pin an explicit list for a demo.
MYSQL_HA_GROUP_SEEDS=
# Group Replication local (peer-to-peer) address of this node. Deliberately NOT
# passed from .env into the node containers: one .env value would be shared by all
# three nodes and a fixed address would collide. node-entrypoint.sh derives it per
# node as <report_host>:${MYSQL_HA_GR_LOCAL_PORT} (report_host differs per node).
# To experiment with an explicit address, set it inside ONE container's rendered
# option file for a demo - it must stay resolvable by the other two.
# The GR PORT is the real knob and it is wired: MYSQL_HA_GR_LOCAL_PORT below.
#MYSQL_HA_GR_LOCAL_ADDRESS=
# Container IPs on Docker Desktop move, so allow every peer in jl-net; combined
# with the loopback-only port policy the group is reachable from inside jl-net only.
MYSQL_HA_GR_IP_ALLOWLIST=0.0.0.0/0
# What a member does when it leaves the group: go read-only instead of accepting
# writes that would diverge (ABORT would kill the container).
MYSQL_HA_EXIT_STATE_ACTION=READ_ONLY
MYSQL_HA_AUTO_REJOIN_TRIES=3
MYSQL_HA_EXPEL_TIMEOUT_SECONDS=5
# Writeset parallel replication on the secondaries.
MYSQL_HA_REPLICA_PARALLEL_WORKERS=4
# performance_schema MUST stay ON: replication_group_members (the membership view
# this lab polls) lives there.
MYSQL_HA_PERFORMANCE_SCHEMA=ON
MYSQL_HA_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_HA_MAX_CONNECTIONS=200

# --- node healthcheck --------------------------------------------------------
# mysqld liveness only (mysqladmin ping), never "is this node ONLINE in the group":
# the nodes have to be healthy before the group exists or the init job deadlocks.
# start_period covers the first initdb, which is the slow part of a cold start.
MYSQL_HA_HEALTHCHECK_INTERVAL_SECONDS=5
MYSQL_HA_HEALTHCHECK_TIMEOUT_SECONDS=5
MYSQL_HA_HEALTHCHECK_RETRIES=30
MYSQL_HA_HEALTHCHECK_START_PERIOD_SECONDS=60

# --- accounts ----------------------------------------------------------------
# docker-library variable: also creates root@'<pattern>', required because the
# init job and the exporters reach the nodes from a container IP, not localhost.
MYSQL_HA_ROOT_HOST=%
# Host part of every account created by mysql-cluster/init/00-cluster-accounts.sql.
MYSQL_HA_ACCOUNT_HOST_PATTERN=%
# Admin used by mysql-shell / the Router bootstrap. root keeps the lab to one
# password (MYSQL_ROOT_PASSWORD); a dedicated account is optional here.
MYSQL_HA_ADMIN_USER=root
# mysqld-exporter per node (defaults to MYSQLD_EXPORTER_PASSWORD from .env.example).
MYSQL_HA_EXPORTER_USER=exporter
MYSQL_HA_EXPORTER_PASSWORD=exporter
MYSQL_HA_EXPORTER_PORT=9104
# Read-only cluster probe used by M3-2b (metrics) and by any external tooling.
# Grants: PROCESS, REPLICATION CLIENT, SELECT on performance_schema /
# information_schema / mysql_innodb_cluster_metadata. No DML, no DDL.
MYSQL_HA_MONITOR_USER=lab_monitor
MYSQL_HA_MONITOR_PASSWORD=labmonitor

# --- cluster bootstrap job ---------------------------------------------------
MYSQL_HA_CLUSTER_NAME=labCluster
MYSQL_HA_EXPECTED_MEMBERS=3
# clone | incremental | recovery: clone is the default because each node's own
# initdb writes GTIDs under a different server_uuid (errant transactions), and a
# clone is the only automatic cure.
MYSQL_HA_RECOVERY_METHOD=clone
# Let mysql-shell flip the runtime-only settings it cares about (SET PERSIST).
MYSQL_HA_CONFIGURE_INSTANCES=true
MYSQL_HA_WAIT_SYNC_TIMEOUT_SECONDS=60
MYSQL_HA_CLUSTER_READY_TIMEOUT_SECONDS=180
MYSQL_HA_CLUSTER_POLL_INTERVAL_SECONDS=5
# Bounded retry for "wait until mysqld answers" - a cold 3-node start normally
# needs a couple of rounds.
MYSQL_HA_INIT_RETRY_COUNT=12
MYSQL_HA_INIT_RETRY_INTERVAL_SECONDS=10
MYSQL_HA_PROBE_TIMEOUT_SECONDS=5
MYSQL_HA_INIT_TMP_DIR=/tmp/lab-mysql-cluster
# true = also print the mysql client's stderr for each failed probe (access denied
# vs connection refused vs unknown variable). Off so the wait loop stays readable.
MYSQL_HA_INIT_DEBUG=false
# Extra dba.createCluster() options as one JSON object, e.g. {"expelTimeout":10}.
# Empty = none (create-cluster.js substitutes {}).
MYSQL_HA_CREATE_CLUSTER_EXTRA_OPTS_JSON=

# --- MySQL Router ------------------------------------------------------------
# 6446 read/write (always the current PRIMARY), 6447 read-only (ONLINE
# secondaries). The *_HOST_PORT keys are what the host sees; both are bound to
# 127.0.0.1 only, matching the dev tier's datastore policy.
MYSQL_HA_ROUTER_RW_PORT=6446
MYSQL_HA_ROUTER_RO_PORT=6447
MYSQL_HA_ROUTER_RW_HOST_PORT=6446
MYSQL_HA_ROUTER_RO_HOST_PORT=6447
# Service name as seen from inside jl-net (the app connects to this, not to a node).
MYSQL_HA_ROUTER_HOST=mysql-router
MYSQL_HA_ROUTER_DATA_DIR=/var/lib/mysqlrouter
MYSQL_HA_ROUTER_CONF_NAME=mysqlrouter.conf
MYSQL_HA_ROUTER_NAME=lab-router
# ROUTING keeps the bootstrap from rewriting the [mysql_source] section scope.
MYSQL_HA_ROUTER_CONF_SCOPE=ROUTING
# TLS to the backends: DISABLED keeps the lab demoable without certificate plumbing.
MYSQL_HA_ROUTER_SSL_MODE=DISABLED
# Account the Router uses for metadata cache refreshes.
MYSQL_HA_ROUTER_USER=mysqlrouter
# How the bootstrap receives the password: stdin (default) | option-file | argv.
# Change only if the image build prompts differently in a non-TTY environment.
MYSQL_HA_ROUTER_PASSWORD_MODE=stdin
MYSQL_HA_ROUTER_FORCE_BOOTSTRAP=false
MYSQL_HA_ROUTER_BOOTSTRAP_EXTRA_OPTS=
MYSQL_HA_ROUTER_HEALTHCHECK_INTERVAL_SECONDS=10
MYSQL_HA_ROUTER_HEALTHCHECK_TIMEOUT_SECONDS=5
MYSQL_HA_ROUTER_HEALTHCHECK_RETRIES=12
MYSQL_HA_ROUTER_HEALTHCHECK_START_PERIOD_SECONDS=15
# Whole healthcheck command, overridable for images without bash (the default is a
# /dev/tcp loopback probe on both routes, so it needs bash, not sh).
#MYSQL_HA_ROUTER_HEALTHCHECK_CMD=bash -c 'exec 3<>/dev/tcp/127.0.0.1/6446'

# --- db-ha-up.sh / db-ha-down.sh ---------------------------------------------
# Profile owning this tier: db-ha (alone) or ha (design §3.3 umbrella, together
# with compose.ha.yml's Redis Sentinel tier).
DB_HA_PROFILE=db-ha
DB_HA_COMPOSE_PROJECT=java-learn-lab
DB_HA_CONTAINER_PREFIX=jl-
DB_HA_NODES="mysql-1 mysql-2 mysql-3"
DB_HA_EXPORTERS="mysql-1-exporter mysql-2-exporter mysql-3-exporter"
DB_HA_CLUSTER_INIT_SERVICE=mysql-cluster-init
DB_HA_ROUTER_INIT_SERVICE=mysql-router-init
DB_HA_ROUTER_SERVICE=mysql-router
# Keys db-ha-up.sh requires (space-separated; validated as UUIDs where applicable).
DB_HA_REQUIRED_KEYS=MYSQL_HA_CLUSTER_GROUP_NAME
# Bounded waits, one per bootstrap phase.
DB_HA_NODE_WAIT_TIMEOUT_SECONDS=240
DB_HA_INIT_WAIT_TIMEOUT_SECONDS=300
DB_HA_INIT_POLL_INTERVAL_SECONDS=5
DB_HA_CLUSTER_HEALTH_TIMEOUT_SECONDS=120
DB_HA_CLUSTER_HEALTH_INTERVAL_SECONDS=5
DB_HA_LOG_TAIL_LINES=40
# Print the memory-budget note (set false to silence it on a big machine).
DB_HA_MEMORY_BUDGET_WARN=true
# Grace period for a clean InnoDB shutdown in db-ha-down.sh.
DB_HA_STOP_TIMEOUT_SECONDS=30
# db-ha-down.sh safety guards: anything outside these patterns is refused.
DB_HA_ALLOWED_SERVICES_REGEX='^(mysql-[123]|mysql-[123]-exporter|mysql-router|mysql-router-init|mysql-cluster-init)$'
DB_HA_ALLOWED_VOLUMES_REGEX='^jl-mysql-[123]-data$|^jl-mysql-router-data$'

# --- db-cluster-status.sh (read-only) ----------------------------------------
DB_CLUSTER_STATUS_NODES="mysql-1 mysql-2 mysql-3"
DB_CLUSTER_STATUS_PROJECT=java-learn-lab
DB_CLUSTER_STATUS_CONTAINER_PREFIX=jl-
# Only the NAME of the in-container variable holding the admin password is used;
# the value is expanded inside the container and never reaches a host command line.
DB_CLUSTER_STATUS_PASSWORD_ENV=MYSQL_ROOT_PASSWORD
DB_CLUSTER_STATUS_TIMEOUT_SECONDS=5
DB_CLUSTER_STATUS_CONNECT_TIMEOUT_SECONDS=5
DB_CLUSTER_STATUS_RETRIES=3
DB_CLUSTER_STATUS_INTERVAL_SECONDS=2
DB_CLUSTER_STATUS_ROUTER_PROBE=true
# Container providing the mysql client for the Router route probe.
DB_CLUSTER_STATUS_PROBE_CONTAINER=jl-mysql-1
