    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "单线程演示（§9.2）的真实 JVM 状态：0 NEW / 1 RUNNABLE / 2 BLOCKED / 3 WAITING / 4 TIMED_WAITING / 5 TERMINATED。值取自 demo 线程的 Thread.getState()，不是记账枚举。注意：它与下方的故障生命周期（ACTIVE/PAUSED/STOPPED）是两套状态机，颜色与刻度故意不同。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 70,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "#8AB8FF", "index": 0, "text": "NEW" },
                "1": { "color": "#73BF69", "index": 1, "text": "RUNNABLE" },
                "2": { "color": "#F2495C", "index": 2, "text": "BLOCKED" },
                "3": { "color": "#FF9830", "index": 3, "text": "WAITING" },
                "4": { "color": "#FADE2A", "index": 4, "text": "TIMED_WAITING" },
                "5": { "color": "#6E6E6E", "index": 5, "text": "TERMINATED" }
              },
              "type": "value"
            }
          ],
          "max": 5,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8AB8FF", "value": null },
              { "color": "#73BF69", "value": 1 },
              { "color": "#F2495C", "value": 2 },
              { "color": "#FF9830", "value": 3 },
              { "color": "#FADE2A", "value": 4 },
              { "color": "#6E6E6E", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 10, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "thread_lab_demo_state_code{job=\"seckill-app\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "演示线程状态（0–5 真实 JVM 态）",
      "type": "state-timeline"
    },
    {
